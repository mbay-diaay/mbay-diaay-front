{
  "name": "mbay-diaay-angular",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "ng serve",
    "dev:local": "ng serve --configuration local",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && vitest run src/lib/no-browser-storage.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "ci": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "@fontsource/poppins": "5.2.7",
    "@material-symbols/svg-400": "0.48.1",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "1.9.4",
    "lucide-angular": "1.0.0",
    "mapbox-gl": "^3.36.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^2.5.5",
    "tslib": "^2.3.0",
