    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^26.6.11",
    "jsdom": "^22.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0"
  }
